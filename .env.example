# =============================================================================
# DecideCommerce – Umgebungsvariablen
# Kopieren nach .env (wird von docker compose automatisch gelesen).
# Für lokale Entwicklung ohne Docker: dieselben Werte in backend/.env bzw. frontend/.env.
# =============================================================================

# --- Datenbank -------------------------------------------------------------------
ENVIRONMENT=development
POSTGRES_USER=decide
# Sonderzeichen im Passwort URL-kodieren, da es Teil der DATABASE_URL ist.
POSTGRES_PASSWORD=bitte-ein-langes-zufaelliges-passwort
POSTGRES_DB=decidecommerce
# 127.0.0.1 = Postgres nur lokal erreichbar (empfohlen). 0.0.0.0 = öffentlich.
POSTGRES_BIND=127.0.0.1

# --- Öffentliche URLs (ohne Slash am Ende) ------------------------------------------
APP_URL=http://localhost:3000
PUBLIC_API_BASE_URL=http://localhost:8000

# --- Interne Kommunikation Frontend -> Backend (Live-Demo) ---------------------------
# Erzeugen z. B. mit: openssl rand -hex 32
INTERNAL_API_SECRET=change-me-local-development-secret

# --- KI-Decision-Engine ----------------------------------------------------------------
# auto      = Claude, wenn ANTHROPIC_API_KEY gesetzt ist, sonst lokale Heuristik
# systemone = Decision-Modell über /v1/systemone: lokal mit Ollama (Tev1) – kein API-Key,
#             keine Daten an Dritte – oder gehostet mit TypeSafe Jev
# anthropic = immer Claude (Heuristik nur als Fallback bei Störungen)
# heuristic = nur lokale Regel-Engine, keine externen Aufrufe
DECISION_ENGINE=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high – Klassifikation braucht wenig Denkaufwand; "low" = schnell & günstig
ANTHROPIC_EFFORT=low

# --- Lokales Decision-Modell (Ollama + Tev1) -------------------------------------------
# Aktivieren:  COMPOSE_PROFILES=local-ai  und  DECISION_ENGINE=systemone
# COMPOSE_PROFILES=local-ai
# CPU-Server: tev1:0.8b (~0,8 GB RAM, ~2 s/Ticket auf 4 Kernen)
# GPU-Server: tev1:4b   (~4,5 GB, deutlich genauer; zusätzlich docker-compose.gpu.yml)
SYSTEMONE_MODEL=tev1:0.8b
# Storno-Schwelle (0-1). Mit eigenen Tickets kalibrieren: backend/evals/run_eval.py
SYSTEMONE_CANCELLATION_THRESHOLD=0.9
# Gehostetes TypeSafe Jev statt lokalem Ollama (Achtung: Hosting in den USA):
# SYSTEMONE_BASE_URL=https://api.typesafe.ai
# SYSTEMONE_API_KEY=
# SYSTEMONE_MODEL=jev-latest
# SYSTEMONE_KEEP_ALIVE=

# --- Betrieb auf einem eigenen Server (Profil https, Caddy + Let's Encrypt) -----------
# COMPOSE_PROFILES=local-ai,https
# APP_DOMAIN=app.deine-domain.de
# API_DOMAIN=api.deine-domain.de
# In Produktion ENVIRONMENT=production und ein eigenes INTERNAL_API_SECRET setzen.
# Backend/Frontend sind standardmäßig nur lokal gebunden; Caddy erreicht sie über das interne Docker-Netz.
# Für direkte öffentliche Ports ausdrücklich BACKEND_BIND=0.0.0.0 / FRONTEND_BIND=0.0.0.0 setzen.
# ENVIRONMENT=production
# INTERNAL_API_SECRET=<mit openssl rand -hex 32 erzeugen>
# Frontend auf Vercel + externe DB (Neon): direkte Verbindung fürs Backend, z. B.
# BACKEND_DATABASE_URL=postgresql://user:pass@ep-xyz.eu-central-1.aws.neon.tech/neondb?sslmode=verify-full

# --- Billing (Stripe) ---------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Preis-IDs aus dem Stripe-Dashboard: Pro-Grundgebühr (monatlich) + nutzungsbasierter Preis (Meter)
STRIPE_PRICE_PRO_BASE=
STRIPE_PRICE_PRO_METERED=
# Event-Name des Stripe Billing Meters (muss mit dem Meter in Stripe übereinstimmen)
STRIPE_METER_EVENT_NAME=decidecommerce_ticket_analyzed
FREE_TIER_MONTHLY_LIMIT=250
MAX_TICKET_CHARS=20000
MAX_REQUEST_BODY_BYTES=262144
RATE_LIMIT_SECRET_KEY_PER_MINUTE=600
RATE_LIMIT_PUBLISHABLE_KEY_PER_MINUTE=60

# --- Asynchrone Analysen ---------------------------------------------------------------
# Bis zu diesem Wert wartet die API inline, danach antwortet sie mit 202 + Job-ID.
ANALYSIS_SYNC_WAIT_SECONDS=1.5
ANALYSIS_WORKER_CONCURRENCY=1
ANALYSIS_MAX_PENDING_PER_TENANT=100
ANALYSIS_JOB_LEASE_SECONDS=120
ANALYSIS_JOB_MAX_ATTEMPTS=3
ANALYSIS_JOB_POLL_INTERVAL_SECONDS=0.2
ANALYSIS_JOB_RETENTION_DAYS=7

# --- Betrieb -------------------------------------------------------------------------------
LOG_LEVEL=INFO
BACKEND_WORKERS=2
# Kommagetrennt; "*" erlaubt das Widget auf allen Shop-Domains (Publishable Keys prüfen
# ihre Domain-Allowlist zusätzlich serverseitig).
CORS_ALLOW_ORIGINS=*
