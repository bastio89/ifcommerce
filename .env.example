# =============================================================================
# DecideCommerce – Umgebungsvariablen
# Kopieren nach .env (wird von docker compose automatisch gelesen).
# Für lokale Entwicklung ohne Docker: dieselben Werte in backend/.env bzw. frontend/.env.
# =============================================================================

# --- Datenbank -------------------------------------------------------------------
POSTGRES_USER=decide
# Sonderzeichen im Passwort URL-kodieren, da es Teil der DATABASE_URL ist.
POSTGRES_PASSWORD=bitte-ein-langes-zufaelliges-passwort
POSTGRES_DB=decidecommerce
# 127.0.0.1 = Postgres nur lokal erreichbar (empfohlen). 0.0.0.0 = öffentlich.
POSTGRES_BIND=127.0.0.1

# --- Öffentliche URLs (ohne Slash am Ende) ------------------------------------------
APP_URL=http://localhost:3000
PUBLIC_API_BASE_URL=http://localhost:8000

# --- Interne Kommunikation Frontend -> Backend (Live-Demo) ---------------------------
# Erzeugen z. B. mit: openssl rand -hex 32
INTERNAL_API_SECRET=bitte-mit-openssl-rand-hex-32-erzeugen

# --- KI-Decision-Engine ----------------------------------------------------------------
# auto      = Claude, wenn ANTHROPIC_API_KEY gesetzt ist, sonst lokale Heuristik
# anthropic = immer Claude (Heuristik nur als Fallback bei Störungen)
# heuristic = nur lokale Regel-Engine, keine externen Aufrufe
DECISION_ENGINE=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high – Klassifikation braucht wenig Denkaufwand; "low" = schnell & günstig
ANTHROPIC_EFFORT=low

# --- Billing (Stripe) ---------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Preis-IDs aus dem Stripe-Dashboard: Pro-Grundgebühr (monatlich) + nutzungsbasierter Preis (Meter)
STRIPE_PRICE_PRO_BASE=
STRIPE_PRICE_PRO_METERED=
# Event-Name des Stripe Billing Meters (muss mit dem Meter in Stripe übereinstimmen)
STRIPE_METER_EVENT_NAME=decidecommerce_ticket_analyzed
FREE_TIER_MONTHLY_LIMIT=250

# --- Betrieb -------------------------------------------------------------------------------
LOG_LEVEL=INFO
BACKEND_WORKERS=2
# Kommagetrennt; "*" erlaubt das Widget auf allen Shop-Domains (Publishable Keys prüfen
# ihre Domain-Allowlist zusätzlich serverseitig).
CORS_ALLOW_ORIGINS=*
